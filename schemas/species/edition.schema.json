{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dnd-portal.invalid/species/edition.schema.json",
  "type": "object",
  "required": [
    "id",
    "contentId",
    "edition",
    "name",
    "mechanics",
    "sources",
    "article"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^species:[a-z0-9]+(?:-[a-z0-9]+)*@[1-5](?:\\.5)?e$"
    },
    "contentId": {
      "type": "string",
      "pattern": "^species:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "edition": {
      "enum": [
        "1e",
        "2e",
        "3e",
        "3.5e",
        "4e",
        "5e",
        "5.5e"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "rulesBasis": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "mechanics": {
      "type": "object",
      "required": [
        "creatureType",
        "size",
        "speed",
        "traits"
      ],
      "properties": {
        "creatureType": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "object",
          "required": [
            "category"
          ],
          "properties": {
            "category": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "choiceRequired": {
              "type": "boolean"
            },
            "selectionTiming": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "speed": {
          "type": "object",
          "required": [
            "walking"
          ],
          "properties": {
            "walking": {
              "type": "object",
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "abilityScoreIncrease": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "abilities": {
              "type": "object"
            },
            "grantedBySpecies": {
              "type": "boolean"
            }
          }
        },
        "languages": {
          "type": "object"
        },
        "age": {
          "type": "object"
        },
        "alignment": {
          "type": "object"
        },
        "background": {
          "type": "object"
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "kind",
              "description",
              "sourceIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                },
                "minItems": 1
              },
              "choice": {
                "type": "object"
              },
              "trigger": {
                "type": "object"
              },
              "resourceRules": {
                "type": "object"
              },
              "grants": {
                "type": "object"
              }
            },
            "additionalProperties": true
          },
          "minItems": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "minItems": 0
        },
        "notGrantedAutomatically": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "excludedAutomaticBenefits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "subraceSelection": {
          "type": "object",
          "description": "Optional, edition-specific selection metadata for a parent species that requires a child option; child mechanics are stored separately and no availability is implied.",
          "required": [
            "required",
            "count",
            "inheritSharedTraits",
            "availability",
            "resolution"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "inheritSharedTraits": {
              "type": "boolean"
            },
            "availability": {
              "enum": [
                "pending-child-content",
                "child-content-available"
              ]
            },
            "resolution": {
              "type": "string",
              "minLength": 1
            },
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": true
        },
        "lineageSelection": {
          "type": "object",
          "description": "Optional reusable parent-to-lineage selection metadata. Describes choices and progression without publishing child mechanics.",
          "required": [
            "required",
            "count",
            "inheritSharedTraits",
            "availability",
            "options",
            "resolution"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "inheritSharedTraits": {
              "type": "boolean"
            },
            "availability": {
              "enum": [
                "pending-child-content",
                "child-content-available"
              ]
            },
            "selectionTiming": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "name",
                  "status"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "pending-child-content",
                      "child-content-available"
                    ]
                  },
                  "contentId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            },
            "spellcastingAbility": {
              "type": "object",
              "required": [
                "requiredChoice",
                "options"
              ],
              "properties": {
                "requiredChoice": {
                  "type": "boolean"
                },
                "choiceTiming": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "appliesTo": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "progression": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "characterLevel",
                  "benefit",
                  "source",
                  "detailsImplemented"
                ],
                "properties": {
                  "characterLevel": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "benefit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "detailsImplemented": {
                    "type": "boolean"
                  },
                  "spellRules": {
                    "type": "object",
                    "properties": {
                      "alwaysPrepared": {
                        "type": "boolean"
                      },
                      "freeCast": {
                        "type": "object",
                        "required": [
                          "uses",
                          "recharge"
                        ],
                        "properties": {
                          "uses": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "recharge": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": true
                      },
                      "mayCastUsingAppropriateSpellSlots": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              }
            },
            "resolution": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "optionalVariants": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.dnd-portal.invalid/common/source.schema.json"
      },
      "minItems": 1
    },
    "article": {
      "type": "object",
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.dnd-portal.invalid/common/article-section.schema.json"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
