{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dnd-portal.invalid/species/options/edition.schema.json",
  "type": "object",
  "required": [
    "id",
    "contentId",
    "parentId",
    "parentEdition",
    "edition",
    "kind",
    "name",
    "inheritsFrom",
    "mechanics",
    "sources",
    "article"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^species-option:[a-z0-9]+(?:-[a-z0-9]+)*@[1-5](?:\\.5)?e$"
    },
    "contentId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^species-option:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "parentId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^species:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "parentEdition": {
      "enum": [
        "1e",
        "2e",
        "3e",
        "3.5e",
        "4e",
        "5e",
        "5.5e"
      ]
    },
    "edition": {
      "enum": [
        "1e",
        "2e",
        "3e",
        "3.5e",
        "4e",
        "5e",
        "5.5e"
      ]
    },
    "kind": {
      "enum": [
        "subrace",
        "lineage",
        "heritage",
        "variant"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "rulesBasis": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "inheritsFrom": {
      "type": "object",
      "required": [
        "contentId",
        "edition",
        "editionId",
        "mergeStrategy"
      ],
      "properties": {
        "contentId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^species:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "edition": {
          "enum": [
            "1e",
            "2e",
            "3e",
            "3.5e",
            "4e",
            "5e",
            "5.5e"
          ]
        },
        "editionId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^species:[a-z0-9]+(?:-[a-z0-9]+)*@[1-5](?:\\.5)?e$"
        },
        "mergeStrategy": {
          "enum": [
            "parent-plus-additions"
          ]
        }
      },
      "additionalProperties": false
    },
    "mechanics": {
      "type": "object",
      "required": [
        "additions",
        "overrides",
        "sourceIds"
      ],
      "properties": {
        "additions": {
          "type": "object",
          "required": [
            "traits"
          ],
          "properties": {
            "abilityScoreIncrease": {
              "type": "object"
            },
            "weaponProficiencies": {
              "type": "object"
            },
            "cantrip": {
              "type": "object"
            },
            "languages": {
              "type": "object"
            },
            "traits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "kind",
                  "description",
                  "sourceIds"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                    },
                    "minItems": 1
                  }
                },
                "additionalProperties": true
              },
              "minItems": 1
            }
          },
          "additionalProperties": true
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "reason",
              "value",
              "sourceIds"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.dnd-portal.invalid/common/source.schema.json"
      },
      "minItems": 1
    },
    "article": {
      "type": "object",
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.dnd-portal.invalid/common/article-section.schema.json"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
